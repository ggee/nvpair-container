PAIR_NODE_NAME=PAIR-SERVER
PAIR_STATE_DIR=./state
PAIR_REQUIRE_OLLAMA=true
PAIR_OLLAMA_PORT=11434
PAIR_EXPECT_PROXY_PORT=11435
